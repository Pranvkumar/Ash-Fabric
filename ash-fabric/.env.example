# ── ASH-Fabric Environment Configuration ──────────────────
# Copy to .env and customize for your setup

# NATS
NATS_URL=nats://localhost:4222

# VictoriaMetrics
VM_ENDPOINT=http://localhost:8428

# Agent Brain
AGENT_BRAIN_URL=http://localhost:8000
SCRIPTS_DIR=./scripts
LOG_DIR=./data/logs

# LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Safety
APPROVAL_REQUIRED=false
